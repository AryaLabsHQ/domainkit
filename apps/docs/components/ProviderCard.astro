---
import ProviderLogo from "./ProviderLogo.astro";

interface Props {
  href: string;
  provider: "cloudflare" | "vercel";
  title: string;
}

const { href, provider, title } = Astro.props;
---

<a class="provider-card" data-blume-card href={href}>
  <ProviderLogo provider={provider} size={20} />
  <p>{title}</p>
  <div><slot /></div>
</a>

<style>
  .provider-card {
    background: var(--blume-background);
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    color: inherit;
    display: block;
    overflow: hidden;
    padding: 1.25rem;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .provider-card:hover {
    border-color: var(--blume-accent);
    text-decoration: none;
  }

  .provider-card p {
    color: var(--blume-foreground);
    font-weight: 500;
    margin: 0.625rem 0 0.375rem;
  }

  .provider-card div {
    color: var(--blume-muted-foreground);
    font-size: 0.875rem;
    font-weight: 400;
  }
</style>
