---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import Tab from "blume/components/content/Tab.astro";
import Tabs from "blume/components/content/Tabs.astro";

import ComponentPreview from "../islands/ComponentPreview.tsx";
import type { StoryId } from "../islands/react-catalog/preview-state.ts";
import { reactExampleSource } from "./react-examples.ts";

interface Props {
  readonly story: StoryId;
}

const { story } = Astro.props;
const code = reactExampleSource[story];
---

<div class="not-prose react-example">
  <Tabs hash={false} sync={false}>
    <Tab class="react-example__preview" title="Preview">
      <ComponentPreview client:only="react" story={story} />
    </Tab>
    <Tab class="react-example__code" title="Code">
      <CodeBlock code={code} lang="tsx" />
    </Tab>
  </Tabs>
</div>

<style>
  .react-example {
    margin-block: 1.5rem 2.25rem;
  }

  .react-example__preview,
  .react-example__code {
    min-height: 20rem;
    overflow: auto;
  }

  .react-example__preview {
    padding: 0 !important;
  }
</style>
