{
  "name": "@domainkit/docs",
  "private": true,
  "description": "DomainKit documentation and interactive React component catalog",
  "keywords": [
    "dns",
    "documentation",
    "domainkit",
    "react"
  ],
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "scripts": {
    "audit": "bun run reference:check && blume audit",
    "build": "bun run reference:check && bun run registry:build && blume build",
    "check": "blume check",
    "deploy": "bun run build && wrangler deploy",
    "dev": "blume dev",
    "preview": "blume preview",
    "reference:check": "bun scripts/check-reference.mts",
    "registry:build": "shadcn build registry.json --output public/r",
    "registry:check": "bun run registry:build && bun scripts/test-registry.mts",
    "registry:validate": "shadcn registry validate registry.json",
    "test": "bun run test:tooling && bun run test:snippets && bun run test:browser",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:snippets": "bun scripts/test-snippets.mts",
    "test:tooling": "bun scripts/test-tooling.mts",
    "typecheck": "blume check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@domainkit/react": "workspace:^0.20.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "blume": "^2.2.1",
    "domainkit": "workspace:^0.20.0",
    "effect": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.8",
    "shadcn": "4.21.4",
    "vite": "8.3.4",
    "wrangler": "4.127.1"
  }
}
