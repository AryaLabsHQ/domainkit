---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { withBase } from "blume/components/islands/base-path.ts";
import data from "blume:data";
import { examplesBase } from "blume:examples";

import ProviderLogo from "../components/ProviderLogo.astro";
import SamvaMark from "../components/SamvaMark.astro";
import { snippet } from "../components/snippets.ts";

const { config } = data;
const pageTitle = "Custom domains for SaaS: DNS setup in your app | DomainKit";
const pageDescription =
  "Your customer connects Cloudflare or Vercel once, reviews the exact DNS records, and approves. DomainKit applies them and verifies they resolve.";

// The same regions the documentation renders, so the landing page cannot drift from the API.
const lifecycle = snippet("examples/core/lifecycle.ts", "program");
const identity = snippet("examples/server/mount.ts", "identity");
const mount = snippet("examples/server/mount.ts", "mount");
const transport = snippet("examples/react/domain-settings.tsx", "setup");
const flow = snippet("examples/react/domain-settings.tsx", "flow");

const flowFrame = withBase(`${examplesBase}/registry/domain-flow`);
const installCommand = "bun add domainkit effect";

const faqs: {
  q: string;
  a: string;
  link?: { href: string; label: string };
  links?: { href: string; label: string }[];
}[] = [
  {
    q: "What does my customer actually see?",
    a: "They connect Cloudflare or Vercel, then see a table of the exact records: which ones will be added, which are already set, and which conflict. One button adds the ones they approved. After that they see each record's status until it resolves. They never type a record value.",
  },
  {
    q: "Does DomainKit issue TLS certificates or proxy traffic?",
    a: "No. It writes DNS records and checks that they resolve. Certificates and traffic belong to your host, such as Cloudflare for SaaS, Vercel, or Approximated. DomainKit writes the CNAME and validation records those services ask your customer to add.",
  },
  {
    q: "What if my customer's DNS isn't on Cloudflare or Vercel?",
    a: "DomainKit can't write there today. Your records are plain values, so your app can show them as a table to add by hand, the way it does now. You can also write a provider adapter for another DNS provider.",
    link: { href: "/docs/guides/implement-provider", label: "Write a provider" },
  },
  {
    q: "What if records already exist, or something fails halfway?",
    a: "Records that already match are left alone. Records in the way are reported as conflicts, and DomainKit does not overwrite them. Writes are not atomic. If one fails after another lands, the receipt records exactly which writes completed, and re-planning turns those into no-ops. Cleanup is a separate plan that removes only records the receipt proves DomainKit created and that still match.",
  },
  {
    q: "Where do provider credentials live?",
    a: "In your database, sealed with your key. DomainKit defines the Custody and Storage interfaces and your app implements them. The browser never receives a credential.",
  },
  {
    q: "Do I have to use Effect?",
    a: "The lifecycle is written in Effect 4, and the services you implement (Identity, Custody, Storage) are Effect services. You can mount the routes behind a plain fetch handler, and browser code can use Promises through the client transport. If your team doesn't use Effect anywhere, plan for a small learning step on the server.",
  },
  {
    q: "What does it cost?",
    a: "Nothing. DomainKit is MIT-licensed open source with no per-domain fee and no paid plan. You run it in your own app, so you pay for your own hosting and database.",
  },
  {
    q: "How is this different from Entri or Domain Connect?",
    a: "Entri is a hosted modal with about 60 providers. Domain Connect is an open protocol where each DNS provider onboards your template. DomainKit is a library in your app that writes through the customer's own Cloudflare or Vercel account. Each fits different teams.",
    links: [{ href: "/compare/entri", label: "DomainKit vs Entri" }, { href: "/compare/domain-connect", label: "DomainKit vs Domain Connect" }],
  },
];

---

<PageLayout
  analytics={config.analytics}
  appleIcon={config.appleIcon}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
  x={config.x}
>
  <main class="fm">
    <section class="hero">
      <div class="hero-copy">
        <p class="label">Open source · MIT · TypeScript</p>
        <h1>Custom domains for your SaaS, without the DNS instructions.</h1>
        <p class="sub">
          A TypeScript library that runs in your app. Your customer connects Cloudflare or Vercel
          once and approves the exact records; DomainKit applies them and verifies they resolve.
        </p>
        <div class="install">
          <code>{installCommand}</code>
          <button type="button" data-copy={installCommand} aria-label="Copy install command">
            Copy
          </button>
        </div>
        <div class="actions">
          <a class="btn primary" href="/docs/quickstart">Quickstart</a>
          <a class="btn ghost" href="/docs">Read the docs</a>
          <a class="textlink" href="https://github.com/AryaLabsHQ/domainkit">GitHub</a>
        </div>
        <a class="chip" href="/customers/samva">
          <SamvaMark class="samva-mark" size={20} />
          <span>Samva sets up customer domains with DomainKit</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-demo">
        <div class="tabs">
          <input type="radio" name="hero-tab" id="tab-server" checked />
          <input type="radio" name="hero-tab" id="tab-react" />
          <input type="radio" name="hero-tab" id="tab-core" />
          <div class="tablist" role="presentation">
            <label for="tab-server">Server</label>
            <label for="tab-react">React</label>
            <label for="tab-core">Core</label>
          </div>
          <div class="panel p-server">
            <CodeBlock code={mount} lang="ts" title="examples/server/mount.ts" />
          </div>
          <div class="panel p-react">
            <CodeBlock code={flow} lang="tsx" title="examples/react/domain-settings.tsx" />
          </div>
          <div class="panel p-core">
            <CodeBlock code={lifecycle} lang="ts" title="examples/core/lifecycle.ts" />
          </div>
        </div>
        <div class="live">
          <iframe
            data-flow-frame
            loading="lazy"
            src={flowFrame}
            title="Live DomainKit domain flow, running on a test provider"></iframe>
          <p class="cap">
            Live demo. Test provider and example domain. Nothing here writes to a real zone.
          </p>
        </div>
      </div>
    </section>

    <section class="block" id="problem">
      <p class="label">[ 01 · The problem ]</p>
      <h2>The DNS instructions page is where setup goes wrong.</h2>
      <div class="prose-cols">
        <p>
          To use their own domain, your customer has to open a registrar they barely know and copy
          three or four fields per record. One screen wants @ for the host. Another wants the bare
          domain. Some add the domain name for you, and some want a dot on the end. Then they click
          Verify and wait.
        </p>
        <p>
          Webflow, Ghost, Framer, Resend, and Postmark all ship pages like this, several with a
          variant for each registrar. They are good pages for a hard problem. They still hand the
          customer the last step.
        </p>
      </div>
      <blockquote class="pull">
        <p>
          "Some of your customers will likely struggle to configure their DNS correctly, and thus
          you will need to provide tech support to them."
        </p>
        <cite>
          <a href="https://answers.netlify.com/t/43190">Netlify support guide, 2021</a>
        </cite>
      </blockquote>
      <div class="compare">
        <figure class="panelbox">
          <p class="label">Today</p>
          <div class="mock-instructions">
            <strong>Connect your domain</strong>
            <ol>
              <li>Log in to your DNS provider.</li>
              <li>
                Add a CNAME record.
                <pre>Host: send   Value: …</pre>
              </li>
              <li>Wait up to 48 hours.</li>
              <li>Click Verify.</li>
            </ol>
          </div>
          <figcaption>A composite of the pattern, not a real vendor page.</figcaption>
        </figure>
        <figure class="panelbox">
          <p class="label">With DomainKit</p>
          <div class="mock-flow">
            <div class="mock-row">
              <span>Cloudflare</span>
              <span class="mock-btn">Connect Cloudflare</span>
            </div>
            <ul class="plan">
              <li><span class="pill add">Will add</span><code>k1._domainkey</code></li>
              <li><span class="pill set">Already set</span><code>_verify</code></li>
            </ul>
            <span class="mock-btn solid">Add 2 records</span>
          </div>
          <figcaption>
            The customer connects once, sees the records, and presses one button.
          </figcaption>
        </figure>
      </div>
      <p class="more"><a href="/compare/manual-dns">Read why copy-paste setup breaks →</a></p>
    </section>

    <section class="block" id="how">
      <p class="label">[ 02 · How it works ]</p>
      <h2>One approval, exact records, checked in public DNS.</h2>
      <ol class="stops">
        <li>
          <span class="n">Connect</span>
          <p>
            Your customer signs in to Cloudflare or Vercel from your app, or pastes a token.
            DomainKit finds the zone that serves the domain.
          </p>
        </li>
        <li>
          <span class="n">Review</span>
          <p>
            They see every record before anything changes. A missing record says Will add. A record
            that already matches says Already set. Anything in the way says Conflict, and DomainKit
            leaves it alone.
          </p>
        </li>
        <li>
          <span class="n">Apply</span>
          <p>
            They approve the exact plan. DomainKit writes what they approved and keeps a receipt of
            each write.
          </p>
        </li>
        <li>
          <span class="n">Verify</span>
          <p>
            DomainKit checks the provider and public DNS and shows where each record stands. If
            something is still pending, it says when it will look again.
          </p>
        </li>
      </ol>
      <figure class="plan-fig">
        <div class="plan-table" role="table" aria-label="Illustrative plan for mail.northwind.app">
          <div class="plan-head" role="row">
            <span role="columnheader">Status</span>
            <span role="columnheader">Type</span>
            <span role="columnheader">Name</span>
            <span role="columnheader">Value</span>
          </div>
          <div class="plan-line" role="row">
            <span role="cell"><span class="pill add">Will add</span></span>
            <span role="cell">CNAME</span>
            <code role="cell">k1._domainkey.mail.northwind.app</code>
            <code role="cell">k1.dkim.example.net</code>
          </div>
          <div class="plan-line" role="row">
            <span role="cell"><span class="pill set">Already set</span></span>
            <span role="cell">TXT</span>
            <code role="cell">_verify.mail.northwind.app</code>
            <code role="cell">verify=8f2c…</code>
          </div>
          <div class="plan-line" role="row">
            <span role="cell"><span class="pill conflict">Conflict</span></span>
            <span role="cell">CNAME</span>
            <code role="cell">track.mail.northwind.app</code>
            <span role="cell">Points to old.tracker.example. DomainKit will not change it.</span>
          </div>
        </div>
        <figcaption>
          Figure 1. Demo with a test provider and an example domain. The plan is illustrative: one
          record to add, one already set, one conflict.
        </figcaption>
      </figure>
      <p class="note">
        Writes go one record at a time. If one fails after another lands, the receipt says how far
        it got. Nothing is rolled back.
      </p>
    </section>

    <section class="block split" id="lifecycle">
      <div class="split-copy">
        <p class="label">[ 03 · The lifecycle ]</p>
        <h2>Plan, approve, apply, observe. Four calls.</h2>
        <p>
          Each step is one call. The plan is a read, so nothing changes until the customer says yes.
        </p>
        <dl class="legend">
          <dt><code>Provision.plan</code></dt>
          <dd>Reads the zone and returns the exact operations.</dd>
          <dt><code>Provision.approve</code></dt>
          <dd>Binds the customer's yes to the plan's digest.</dd>
          <dt><code>Provision.apply</code></dt>
          <dd>Writes what was approved and returns a receipt.</dd>
          <dt><code>Verify.observe</code></dt>
          <dd>Checks the provider and public DNS, and says when to look again.</dd>
        </dl>
        <p class="aside">
          Every failure is one <code>DomainKit.Error</code> with a tagged reason, so you can match on
          it. <a href="/docs/core/errors">Failure reasons →</a>
        </p>
        <p><a class="btn primary" href="/docs/quickstart">Run it in the Quickstart</a></p>
      </div>
      <div class="split-code">
        <CodeBlock code={lifecycle} lang="ts" title="examples/core/lifecycle.ts" />
      </div>
    </section>

    <section class="block" id="safety">
      <p class="label">[ 04 · Safety model ]</p>
      <h2>The customer stays in charge, and so does your app.</h2>
      <div class="cells">
        <article>
          <span class="idx">01</span>
          <h3>Review before write</h3>
          <p>
            The plan is additive. DomainKit creates missing records, leaves exact matches alone, and
            reports incompatible state as a conflict. It never updates or deletes a record it did
            not create.
          </p>
          <a href="/docs/core/plans">How plans work →</a>
        </article>
        <article>
          <span class="idx">02</span>
          <h3>Consent is a digest</h3>
          <p>
            Approval is bound to the plan's digest. Before it writes, apply plans the zone again. If
            the zone changed since the customer looked, apply stops with Stale.
          </p>
        </article>
        <article>
          <span class="idx">03</span>
          <div class="provider-pair">
            <ProviderLogo provider="cloudflare" size={22} />
            <ProviderLogo provider="vercel" size={18} />
          </div>
          <h3>Your app keeps custody</h3>
          <p>
            Your key seals the credential. Your database holds the rows. Your session says who is
            calling. No credential reaches the browser, and there is no hosted service holding your
            customers' tokens.
          </p>
          <a href="/docs/guides/storage">Custody and storage →</a>
        </article>
        <article>
          <span class="idx">04</span>
          <h3>Verification with evidence</h3>
          <p>
            For each record, DomainKit stores what the provider returned and what each public
            resolver saw, then schedules the next check.
          </p>
          <a href="/docs/core/verification">How verification works →</a>
        </article>
      </div>
      <p class="strip-note">
        <strong>Cleanup is a separate approval.</strong> Removing records is its own plan, bound to
        an apply receipt. A record someone edited by hand is left alone.
        <a href="/docs/core/cleanup">Cleanup →</a>
      </p>
    </section>

    <section class="block" id="production">
      <p class="label">[ 05 · In production ]</p>
      <h2>Samva runs its customer domain setup on DomainKit.</h2>
      <div class="prod">
        <div>
          <p>
            Samva is an email API. When a customer adds a sending domain, Samva uses DomainKit to
            add the SPF and verification TXT records, the MX records, and the DKIM and tracking
            CNAME records to the customer's Cloudflare or Vercel zone, after they approve the plan.
          </p>
          <p class="links">
            <a href="/customers/samva">Read the Samva case study →</a>
            <a href="https://samva.dev">Visit Samva</a>
          </p>
        </div>
        <figure class="testimonial">
          <a class="samva-logo" href="https://samva.dev" aria-label="Samva">
            <SamvaMark class="samva-mark" size={40} />
            <span>Samva</span>
          </a>
          <blockquote>
            <p>
              Onboarding gets difficult mainly because of DNS. Copying and pasting records is
              error-prone and it increases support cases. That's what we built DomainKit to solve.
            </p>
          </blockquote>
          <figcaption>Saatvik Arya, founder, Samva</figcaption>
        </figure>
      </div>
    </section>

    <section class="block" id="integrate">
      <p class="label">[ 06 · Integrate ]</p>
      <h2>Mount it in your API. Ship the UI.</h2>
      <div class="two">
        <div class="col">
          <h3>On your server</h3>
          <p>
            One route group with twenty-five endpoints, and an OpenAPI document with it. You write
            one service, Identity, that says who is calling and what they can reach. Storage and
            custody come from your own database and key.
          </p>
          <CodeBlock code={identity} lang="ts" title="examples/server/mount.ts#identity" />
          <CodeBlock code={mount} lang="ts" title="examples/server/mount.ts#mount" />
          <p><a href="/docs/guides/host-integration">Host integration guide →</a></p>
        </div>
        <div class="col">
          <h3>In your app</h3>
          <p>
            One hook, <code>Domain.useFlow</code>, runs connect, plan, approve, apply, and verify.
            Render it yourself, or copy the styled block into your project and change anything.
          </p>
          <CodeBlock code={transport} lang="tsx" title="examples/react/domain-settings.tsx#setup" />
          <CodeBlock code={flow} lang="tsx" title="examples/react/domain-settings.tsx#flow" />
          <div class="install">
            <code>npx shadcn@latest add https://domain-kit.dev/r/domain-flow.json</code>
          </div>
          <p>
            <a href="/docs/react">React docs →</a> <a href="/components">Browse the components →</a>
          </p>
        </div>
      </div>
      <p class="note">
        DomainKit is Effect 4 underneath. Browser code can stay in Promises through{" "}
        <code>Transport.toAsync</code>.
      </p>
    </section>

    <section class="block" id="boundaries">
      <p class="label">[ 07 · Boundaries ]</p>
      <h2>What DomainKit is not.</h2>
      <div class="cells">
        <article>
          <h3>Not a DNS host or registrar.</h3>
          <p>Your customer's records stay at their own provider.</p>
        </article>
        <article>
          <h3>Not TLS or traffic.</h3>
          <p>
            DomainKit writes DNS records. Certificates and routing stay with your host, such as
            Cloudflare for SaaS or Vercel.
          </p>
          <a href="/compare/cloudflare-for-saas">Using DomainKit with Cloudflare for SaaS →</a>
        </article>
        <article>
          <h3>Not a hosted service.</h3>
          <p>
            It runs in your app, with your database and your key. There is no SLA and no support
            contract.
          </p>
        </article>
        <article>
          <h3>Two providers today.</h3>
          <p>
            Cloudflare and Vercel are built in. For any other provider, your app shows the records
            to add by hand, or you write an adapter. Entri lists about 60 providers, and that
            matters if your customers are mostly elsewhere.
          </p>
          <a href="/compare/entri">DomainKit vs Entri →</a>
        </article>
      </div>

      <h2 class="faq-title">Questions</h2>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>
                {item.a}
                {item.link && (
                  <>
                    {" "}
                    <a href={item.link.href}>{item.link.label} →</a>
                  </>
                )}
                {item.links?.map((l) => (
                  <>
                    {" "}
                    <a href={l.href}>{l.label} →</a>
                  </>
                ))}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="band">
      <h2>Add custom domains to your product.</h2>
      <p>The Quickstart runs the whole lifecycle in memory, with no credentials.</p>
      <div class="install center">
        <code>{installCommand}</code>
        <button type="button" data-copy={installCommand} aria-label="Copy install command">
          Copy
        </button>
      </div>
      <div class="actions center">
        <a class="btn primary" href="/docs/quickstart">Quickstart</a>
        <a class="btn ghost" href="https://github.com/AryaLabsHQ/domainkit">GitHub</a>
        <a class="btn ghost" href="https://www.npmjs.com/package/domainkit">npm</a>
      </div>
    </section>

    <footer class="foot">
      <div>
        <strong>Docs</strong>
        <a href="/docs">Documentation</a>
        <a href="/components">Components</a>
      </div>
      <div>
        <strong>Guides</strong>
        <a href="/guides/custom-domain-onboarding">Custom domain setup</a>
        <a href="/guides/email-domain-setup">Email domain setup</a>
      </div>
      <div>
        <strong>Compare</strong>
        <a href="/compare/entri">Entri</a>
        <a href="/compare/cloudflare-for-saas">Cloudflare for SaaS</a>
        <a href="/compare/domain-connect">Domain Connect</a>
        <a href="/compare/manual-dns">Manual DNS</a>
      </div>
      <div>
        <strong>Customers</strong>
        <a href="/customers/samva">Samva</a>
      </div>
      <div>
        <strong>Project</strong>
        <a href="https://github.com/AryaLabsHQ/domainkit">GitHub</a>
        <a href="https://www.npmjs.com/package/domainkit">npm</a>
        <span>MIT licensed</span>
      </div>
    </footer>
  </main>
</PageLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1600);
      } catch {
        button.textContent = "Select and copy";
      }
    });
  }

  // The preview frame reports its rendered height the way Blume's own <Component> frames do.
  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin || event.data?.type !== "blume:example-height") {
      return;
    }
    const frame = document.querySelector<HTMLIFrameElement>("iframe[data-flow-frame]");
    if (frame && frame.contentWindow === event.source && Number.isFinite(event.data.height)) {
      frame.style.height = `${Math.max(420, Math.min(event.data.height, 760))}px`;
    }
  });
</script>

<style>
  .fm {
    --gutter: clamp(1rem, 4vw, 2rem);
    border-inline: 1px dashed var(--fm-hairline);
    margin: 0 auto;
    max-width: 76rem;
    padding: clamp(4.5rem, 9vw, 7rem) var(--gutter) 3rem;
    font-size: 1rem;
    line-height: 1.6;
    overflow-x: clip;
  }
  @media (max-width: 80rem) {
    .fm {
      border-inline: 0;
    }
  }
  .fm :global(a) {
    text-underline-offset: 3px;
  }
  .fm p {
    margin: 0 0 1rem;
  }
  .fm a:not(.btn):not(.chip):not(.textlink):not(.samva-logo) {
    color: var(--fm-link);
  }
  code {
    font-family: var(--blume-font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .label {
    color: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }
  h1,
  h2,
  h3 {
    color: var(--blume-foreground);
    font-family: var(--blume-font-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.6rem);
    line-height: 1.04;
    margin: 0 0 1.25rem;
  }
  h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    line-height: 1.1;
    margin: 0 0 1.5rem;
    max-width: 40rem;
  }
  h3 {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
  }
  .hero-copy,
  .hero-demo {
    min-width: 0;
  }
  .sub {
    color: var(--blume-muted-foreground);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .install {
    align-items: stretch;
    background: var(--fm-panel);
    border: 1px solid var(--fm-hairline);
    display: flex;
    margin: 1.25rem 0;
    max-width: 100%;
  }
  .install code {
