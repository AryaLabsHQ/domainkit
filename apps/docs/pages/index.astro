---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import ProviderLogo from "../components/ProviderLogo.astro";

const { config } = data;
const pageTitle = "Add custom domains to your app | DomainKit";
const pageDescription =
  "Connect a DNS provider, review the records your product needs, and apply the approved plan while your app keeps control of credentials.";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{ description: pageDescription, route: "/", title: pageTitle }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
  x={config.x}
>
  <main class="landing">
    <section class="hero">
      <h1>Add custom domains to your app</h1>
      <p class="lede">
        DomainKit connects a DNS provider, shows the exact changes, and applies
        only the approved plan. Your app keeps control of credentials, storage,
        policy, and the customer experience.
      </p>
      <div class="actions">
        <a class="primary" href="/docs">Read the docs</a>
        <a href="https://github.com/AryaLabsHQ/domainkit">View on GitHub</a>
      </div>
    </section>

    <section class="features" aria-label="DomainKit capabilities">
      <article>
        <span>01</span>
        <h2>Review before writing</h2>
        <p>Show exact creates, no-ops, and conflicts before a user approves a write.</p>
      </article>
      <article>
        <div class="provider-pair">
          <ProviderLogo provider="cloudflare" size={24} />
          <ProviderLogo provider="vercel" size={20} />
        </div>
        <h2>Keep control in your app</h2>
        <p>Use Cloudflare or Vercel while your application owns consent, secrets, and storage.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Choose your interface</h2>
        <p>Use ready-made React flows, build your own screen, or render DNS records directly.</p>
      </article>
    </section>
  </main>
</PageLayout>

<style>
  .landing {
    margin: 0 auto;
    max-width: 76rem;
    padding: clamp(5rem, 11vw, 9rem) 1.5rem 5rem;
  }

  .hero {
    max-width: 60rem;
  }

  h1 {
    font-family: var(--blume-font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.96;
    margin: 0;
    text-wrap: balance;
  }

  .lede {
    color: var(--blume-muted-foreground);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    margin: 2rem 0 0;
    max-width: 48rem;
  }

  .actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .actions a {
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    color: inherit;
    font-weight: 600;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .actions .primary {
    background: var(--blume-action);
    border-color: transparent;
    color: var(--blume-action-foreground);
  }

  .features {
    border-top: 1px solid var(--blume-border);
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-top: 2.5rem;
  }

  article > span {
    color: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
  }

  .provider-pair {
    align-items: center;
    display: flex;
    gap: 0.65rem;
    min-height: 1.5rem;
  }

  h2 {
    font-size: 1.1rem;
    margin: 1rem 0 0.55rem;
  }

  article p {
    color: var(--blume-muted-foreground);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 48rem) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
