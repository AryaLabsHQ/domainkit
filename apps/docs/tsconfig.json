{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/components/domainkit/*": ["./registry/domainkit/*"],
      "@/components/ui/copy-value": ["./registry/ui/copy-value.tsx"],
      "@/components/ui/dns-status": ["./registry/ui/dns-status.tsx"],
      "@/components/ui/provider-mark": ["./registry/ui/provider-mark.tsx"],
      "@/components/ui/*": ["./preview/ui/*"],
      "@/lib/*": ["./preview/lib/*"]
    },
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": [".blume/.astro/types.d.ts", ".blume/src/env.d.ts", "**/*"]
}
