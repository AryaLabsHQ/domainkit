{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainkit-docs",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "domain-kit.dev",
      "custom_domain": true,
    },
  ],
}
