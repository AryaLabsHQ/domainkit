{
  "name": "domainkit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "docs:audit": "bun run --filter @domainkit/docs audit",
    "docs:build": "bun run --filter @domainkit/docs build",
    "docs:dev": "bun run --filter @domainkit/docs dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:rules": "node --test tools/oxlint/*.test.js",
    "release:check": "bun run lint && bun run lint:rules && bun run format:check && bun run --filter domainkit release:check && bun run --filter @domainkit/react release:check",
    "tegami": "bun scripts/tegami.mts",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tegami": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
