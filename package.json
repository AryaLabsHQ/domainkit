{
  "name": "domainkit-workspace",
  "private": true,
  "description": "DomainKit workspace for adding custom domains to apps with reviewable DNS plans.",
  "keywords": [
    "custom-domains",
    "dns",
    "domainkit",
    "effect",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/AryaLabsHQ/domainkit#readme",
  "bugs": {
    "url": "https://github.com/AryaLabsHQ/domainkit/issues"
  },
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "docs:audit": "bun run --filter @domainkit/docs audit",
    "docs:build": "bun run --filter @domainkit/docs build",
    "docs:dev": "bun run --filter @domainkit/docs dev",
    "docs:deploy": "bun run --filter @domainkit/docs deploy",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:rules": "node --test tools/oxlint/*.test.js",
    "postinstall": "bun scripts/prepare-capsuledb-git-dependency.mts",
    "release:check": "bun run lint && bun run lint:rules && bun run format:check && bun run --filter domainkit release:check && bun run --filter @domainkit/capsuledb release:check",
    "tegami": "bun scripts/tegami.mts",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter domainkit build && bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "semver": "^7.8.5",
    "tegami": "1.4.0"
  },
  "overrides": {
    "capsuledb": "git+https://github.com/aryasaatvik/CapsuleDB.git#860ae859adb63f2af365cd6d785115270b35bff3"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "blume@1.5.3": "patches/blume@1.5.3.patch"
  }
}
