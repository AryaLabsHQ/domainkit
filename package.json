{
  "name": "domainkit",
  "version": "0.0.1",
  "description": "Provider-independent DNS provisioning plans and authorization for TypeScript",
  "keywords": [
    "dns",
    "domain",
    "domain-connect",
    "effect",
    "typescript"
  ],
  "homepage": "https://github.com/AryaLabsHQ/domainkit#readme",
  "bugs": {
    "url": "https://github.com/AryaLabsHQ/domainkit/issues"
  },
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./effect": {
      "types": "./dist/effect.d.mts",
      "import": "./dist/effect.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "architecture:check": "bun scripts/check-architecture.mts",
    "clean": "rm -rf dist coverage",
    "consumer:audit": "bun scripts/check-consumers.mts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "pack:audit": "bun scripts/check-package.mts",
    "release:check": "bun run lint && bun run format:check && bun run typecheck && bun run architecture:check && bun run test && bun run build && bun run pack:audit && bun run consumer:audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oauth4webapi": "^3.8.7",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "bun@1.4.0"
}
