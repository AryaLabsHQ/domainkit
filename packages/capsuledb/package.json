{
  "name": "@domainkit/capsuledb",
  "version": "0.20.1",
  "description": "DomainKit Storage on PostgreSQL, as one declarative CapsuleDB capsule",
  "keywords": [
    "dns",
    "domainkit",
    "effect",
    "postgresql",
    "typescript"
  ],
  "homepage": "https://domain-kit.dev",
  "bugs": {
    "url": "https://github.com/AryaLabsHQ/domainkit/issues"
  },
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git",
    "directory": "packages/capsuledb"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "release:check": "bun run typecheck && bun run test && bun run build && bun run test:artifact",
    "test": "vitest run --exclude tests/artifact/**/*.test.ts",
    "test:artifact": "vitest run tests/artifact",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "domainkit": "workspace:^0.20.0"
  },
  "devDependencies": {
    "@effect/sql-pg": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "1.4.0",
    "capsuledb": "0.5.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "7.1.12",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "capsuledb": ">=0.5.0 <0.6.0",
    "effect": ">=4.0.0 <5.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
