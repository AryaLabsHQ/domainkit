{
  "name": "domainkit",
  "version": "0.9.1",
  "description": "Build reviewable DNS plans for custom domains in TypeScript",
  "keywords": [
    "custom-domains",
    "dns",
    "domain",
    "domain-connect",
    "domainkit",
    "effect",
    "typescript"
  ],
  "homepage": "https://github.com/AryaLabsHQ/domainkit#readme",
  "bugs": {
    "url": "https://github.com/AryaLabsHQ/domainkit/issues"
  },
  "license": "MIT",
  "author": "Arya Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/types/entry/client.d.ts",
      "import": "./dist/entry/client.mjs"
    },
    "./server": {
      "types": "./dist/types/entry/server.d.ts",
      "import": "./dist/entry/server.mjs"
    },
    "./testing": {
      "types": "./dist/types/entry/testing.d.ts",
      "import": "./dist/entry/testing.mjs"
    },
    "./Approval": {
      "types": "./dist/types/Approval.d.ts",
      "import": "./dist/Approval.mjs"
    },
    "./Cleanup": {
      "types": "./dist/types/Cleanup.d.ts",
      "import": "./dist/Cleanup.mjs"
    },
    "./Cloudflare": {
      "types": "./dist/types/Cloudflare.d.ts",
      "import": "./dist/Cloudflare.mjs"
    },
    "./Connect": {
      "types": "./dist/types/Connect.d.ts",
      "import": "./dist/Connect.mjs"
    },
    "./Custody": {
      "types": "./dist/types/Custody.d.ts",
      "import": "./dist/Custody.mjs"
    },
    "./DnsRecord": {
      "types": "./dist/types/DnsRecord.d.ts",
      "import": "./dist/DnsRecord.mjs"
    },
    "./DomainKit": {
      "types": "./dist/types/DomainKit.d.ts",
      "import": "./dist/DomainKit.mjs"
    },
    "./DomainName": {
      "types": "./dist/types/DomainName.d.ts",
      "import": "./dist/DomainName.mjs"
    },
    "./Plan": {
      "types": "./dist/types/Plan.d.ts",
      "import": "./dist/Plan.mjs"
    },
    "./Principal": {
      "types": "./dist/types/Principal.d.ts",
      "import": "./dist/Principal.mjs"
    },
    "./Provider": {
      "types": "./dist/types/Provider.d.ts",
      "import": "./dist/Provider.mjs"
    },
    "./Providers": {
      "types": "./dist/types/Providers.d.ts",
      "import": "./dist/Providers.mjs"
    },
    "./Provision": {
      "types": "./dist/types/Provision.d.ts",
      "import": "./dist/Provision.mjs"
    },
    "./Reason": {
      "types": "./dist/types/Reason.d.ts",
      "import": "./dist/Reason.mjs"
    },
    "./Receipt": {
      "types": "./dist/types/Receipt.d.ts",
      "import": "./dist/Receipt.mjs"
    },
    "./Resolver": {
      "types": "./dist/types/Resolver.d.ts",
      "import": "./dist/Resolver.mjs"
    },
    "./Storage": {
      "types": "./dist/types/Storage.d.ts",
      "import": "./dist/Storage.mjs"
    },
    "./Vercel": {
      "types": "./dist/types/Vercel.d.ts",
      "import": "./dist/Vercel.mjs"
    },
    "./Verify": {
      "types": "./dist/types/Verify.d.ts",
      "import": "./dist/Verify.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "release:check": "bun run typecheck && bun run test && bun run build && bun run typecheck:examples && bun run test:artifact",
    "test": "vitest run --exclude tests/artifact/**/*.test.ts",
    "test:artifact": "vitest run tests/artifact",
    "test:consumers": "vitest run tests/artifact/packed-consumers.test.ts",
    "test:live:cloudflare": "bun tests/live/cloudflare.ts",
    "test:live:vercel": "bun tests/live/vercel.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --project tsconfig.examples.json",
    "test:providers": "vitest run tests/providers"
  },
  "dependencies": {
    "@leichtgewicht/dns-packet": "6.0.3",
    "oauth4webapi": "^3.8.7",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.0",
    "effect": "4.0.0-rc.112",
    "miniflare": "3.20250718.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "bun@1.4.0"
}
