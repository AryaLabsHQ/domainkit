{
  "name": "@domainkit/react",
  "version": "0.3.0",
  "description": "Accessible React flows for DomainKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun scripts/copy-styles.ts",
    "release:check": "bun run typecheck && bun run test && bun run build && bun run test:artifact && bun run test:browser",
    "test": "vitest run --exclude tests/artifact/**/*.test.ts",
    "test:artifact": "vitest run tests/artifact",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "workshop": "vite examples/vite --host 127.0.0.1 --port 4178"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "domainkit": "^0.3.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@effect/atom-react": "4.0.0-rc.112",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "1.57.0",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/scheduler": "0.26.0",
    "dialkit": "1.4.3",
    "effect": "4.0.0-rc.112",
    "jsdom": "26.1.0",
    "motion": "13.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grab": "0.2.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "7.1.12",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@effect/atom-react": ">=4.0.0-rc.112 <5.0.0",
    "effect": ">=4.0.0-rc.112 <5.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
