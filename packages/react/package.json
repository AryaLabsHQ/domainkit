{
  "name": "@domainkit/react",
  "version": "0.1.0",
  "description": "Accessible React flows for DomainKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AryaLabsHQ/domainkit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "release:check": "bun run typecheck && bun run test && bun run build && bun run test:artifact",
    "test": "vitest run --exclude tests/artifact/**/*.test.ts",
    "test:artifact": "vitest run tests/artifact",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "domainkit": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "7.1.12",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
